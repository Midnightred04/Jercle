rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      // REPLACE WITH UID FROM Firebase Authentication > Users BEFORE PUBLISHING
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_JERCLE_USER_UID';
    }
    function validEvent(d) {
      return d.keys().hasOnly(['title','description','location','startDate','endDate','startTime','timezone','createdAt','updatedAt','deletedAt'])
        && d.keys().hasAll(['title','description','location','startDate','endDate','startTime','timezone','createdAt','updatedAt','deletedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.description is string && d.description.size() <= 2000
        && d.location is string && d.location.size() > 0 && d.location.size() <= 160
        && d.startDate is string && d.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.endDate is string && d.endDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.endDate >= d.startDate
        && d.startTime is string && d.startTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]|')
        && d.timezone == 'Asia/Dubai'
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && (d.deletedAt == null || d.deletedAt is timestamp);
    }
    function validBrainstorm(d) {
      return d.keys().hasOnly(['name','description','createdAt'])
        && d.keys().hasAll(['name','description','createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.description is string && d.description.size() > 0 && d.description.size() <= 2000
        && d.createdAt is timestamp;
    }
    match /brainstorms/{ideaId} {
      allow get, list: if member();
      allow create: if member() && validBrainstorm(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if member() && validBrainstorm(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description']);
      allow delete: if false;
    }
    match /events/{eventId} {
      allow get, list: if member();
      allow create: if member() && validEvent(request.resource.data)
        && request.resource.data.deletedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if member() && validEvent(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (resource.data.deletedAt == null || request.resource.data.deletedAt == resource.data.deletedAt);
      allow delete: if false;
    }
  }
}
